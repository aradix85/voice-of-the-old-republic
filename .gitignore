# Build artifacts and run logs
/build/
**/logs/

# Local KOTOR save backups taken during testing — game data, never committed.
/save-backups/

# Local cache of crash dumps + log bundles uploaded by beta testers.
# Often hundreds of MB (full-heap WER dumps); never redistributable.
/userlogs/

# Debug symbols for shipped builds, archived per release tag by
# installer/release.ps1 (three versions back). A PDB only matches the one
# binary it was built from, so these are what turn a tester's crash dump into
# named functions and line numbers instead of a module+offset. Local-only:
# symbols make the binary trivially readable and are recreatable from the tag.
/symbols/

# dinput8.dll proxy loader — source in loader/ is tracked, binaries
# rebuilt via loader/build.bat.
/loader/*.dll
/loader/*.exp
/loader/*.lib
/loader/*.obj

# Local cache of reference game data we want to keep between sessions
# (e.g. per-locale dialog.tlk copies under data/dialog-tlk/). BioWare
# content — never commit; recreate by re-extracting from a Steam install
# at the right language. See tools/kdev/Commands/CombatStringsExtractCommand.cs
# for the --lang shorthand that resolves to this cache.
/data/

# .NET build output (kdev, dbgcapture)
**/bin/
**/obj/

# Visual Studio / Rider local files
.vs/
.idea/
*.user
*.suo

# OS / editor
.DS_Store
Thumbs.db
*~
*.swp

# Claude Code local-only config (per-user permissions/hooks + runtime state)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Internal dev tooling — tools/kdev (build/install/launch CLI), tools/dbgcapture
# (OutputDebugString sink), tools/ghidra-scripts (headless decompile drivers) —
# is TRACKED as of 2026-07-29. It carries no game-derived data: the Ghidra
# scripts are generic drivers, and kdev's RE-adjacent code (FunctionTable,
# Signatures, EngineAddresses) only *reads* artifacts supplied locally — a
# Ghidra XML export, the installed executable, our own patch sources. Build
# output is excluded by the **/bin/ and **/obj/ rules above.

# Decompiled / reverse-engineered game artifacts: Lane Dibello's Ghidra
# database (gzf/xml/sarif/h) and architecture PDF. Not redistributable —
# mirror locally from his Google Drive (links: https://deadlystream.com/topic/11948-kotor-1-gog-reverse-engineering/).
# Narrative markdown docs at the root of llm-docs are tracked; only the
# binary RE artifacts under re/ stay local. code-index/ holds per-file
# LLM-readable summaries generated by the llm-mod-refactoring-prompts
# code-directory-construction phase.
/docs/llm-docs/*
!/docs/llm-docs/*.md
!/docs/llm-docs/CLAUDE.md
!/docs/llm-docs/code-index/
!/docs/llm-docs/code-index/**
# re/k2/ is OURS, unlike the rest of re/: generated by tools/re-scripts/ from
# the user's own KOTOR 2 install, plain text, and small. Tracked so the class
# -> vtable map is usable without having the executable to hand.
#
# Three lines, and the order is load-bearing: git will not re-include anything
# under an excluded DIRECTORY, so re/ has to be un-excluded first, its contents
# excluded again, and only then k2/ let back in.
!/docs/llm-docs/re/
/docs/llm-docs/re/*
!/docs/llm-docs/re/k2/

# Upstream third-party clones — recreatable from public repos:
#   KotorMessageInjector: https://github.com/LaneDibello/KotorMessageInjector
#   KotOR_IO: https://github.com/LaneDibello/KotOR_IO
#   DLZ-Tool: https://github.com/Lane-Dibello/DLZ-Tool
# The NVDA controller client (third_party/nvda/) is kept — LGPL distribution
# requirement.
#
# Kotor-Patch-Manager is intentionally NOT ignored: we vendor it so our
# framework modifications travel with normal commits. The upstream commit
# we forked from is recorded in docs/framework-changes-backup.patch.
/third_party/KotorMessageInjector/
/third_party/KotOR_IO/
/third_party/DLZ-Tool/
# dsoal — read-only reference clone; we ship the prebuilt binaries
# bundled in the installer Resources/ folder, not the source.
/third_party/dsoal/

__pycache__/
